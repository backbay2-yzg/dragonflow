<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dragonflow.exe"
        Arguments=""
        InstallLocation="C:\Program Files\DragonFlow\DragonFlow">
    </Installer>
    <PackageInformation
        PackageName="DragonFlow"
        PackageDisplayName="DragonFlow"
        PublisherName="CN=DragonFlow"
        PublisherDisplayName="DragonFlow"
        Version="0.1.0.0"
        PackageDescription="DragonFlow AI SDLC Mission Control">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.dragonflow.desktop"
                Description="DragonFlow AI SDLC Mission Control"
                DisplayName="DragonFlow"
                ExecutableName="dragonflow.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>DragonFlow</DisplayName>
            <PublisherDisplayName>DragonFlow</PublisherDisplayName>
            <Description>DragonFlow AI SDLC Mission Control</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dragonflow.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
